{
 "condition": "B2",
 "temperature_C": 70,
 "simulation_time_s": 43200,
 "initial_concentrations": {
  "bispyr": 0.1,
  "roh": 0.2,
  "me2pyr": 0.0,
  "map": 0.0,
  "bis": 0.0
 },
 "sigma_kcal_mol": 3.0,
 "n_samples": 1000,
 "random_seed": 42,
 "mode": "full",
 "n_reactions": 1,
 "reactions": [
  "im0-ROH28"
 ],
 "save_trajectories": false,
 "integration": {
  "solver": "BDF",
  "rtol": 1e-12,
  "atol": 1e-12,
  "points": 1000,
  "exponent": 3
 },
 "perturbation": {
  "intermediates": [
   "map",
   "bis"
  ],
  "transition_states": [
   "ts1",
   "ts2"
  ],
  "scheme": "A ~ N(0, sigma) nos intermediarios; x_j A, x_j ~ U(0,1), em cada estado de transicao"
 }
}